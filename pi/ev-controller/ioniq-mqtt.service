[Unit]
Description=IONIQ 5 readings from the WiCAN via MQTT
After=network-online.target mosquitto.service
Wants=mosquitto.service

[Service]
User=matt
WorkingDirectory=/home/matt/solar-hub-pi
ExecStart=/home/matt/solar-hub-pi/evtest/bin/python /home/matt/solar-hub-pi/ioniq_mqtt.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
