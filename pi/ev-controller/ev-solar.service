[Unit]
Description=Solar Hub EV solar charging controller
After=network-online.target
Wants=network-online.target

[Service]
User=matt
WorkingDirectory=/home/matt/solar-hub-pi
Environment=DRY_RUN=1
ExecStart=/home/matt/solar-hub-pi/evtest/bin/python /home/matt/solar-hub-pi/ev_solar.py
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
